{
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "framework": "vite",
  "headers": [
    {
      "source": "/(images|videos|resources|uploads)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)\\.([a-zA-Z0-9]+)$", "dest": "/$1.$2" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
