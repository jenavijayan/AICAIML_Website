{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/uploads/(.*)", "destination": "/uploads/$1" },
    { "source": "/images/(.*)", "destination": "/images/$1" },
    { "source": "/videos/(.*)", "destination": "/videos/$1" },
    { "source": "/resources/(.*)", "destination": "/resources/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(images|videos|resources|uploads)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
